# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://clinicmind:clinicmind@localhost:5432/clinicmind
WEBHOOK_SECRET=change-me

# --- LLM (Gemini) ---
GEMINI_API_KEY=change-me
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=45
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Paid-tier price per 1M tokens (USD), for cost estimates in llm_calls and the evals
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# --- Optional integrations (leave empty to disable) ---
SLACK_WEBHOOK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
